# Independent Node.js API settings.
API_PORT=4000
API_HOST=127.0.0.1
FRONTEND_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:4000
# Server-only Supabase Postgres session pooler connection. Never use a NEXT_PUBLIC_ prefix.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_CA_FILE=certs/supabase-ca.crt
# Required in production. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=
STORAGE_DIR=storage
# GitHub OAuth App credentials: Node backend only.
# Local callback URL: http://localhost:4000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Production email verification and password recovery (your SMTP provider).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
